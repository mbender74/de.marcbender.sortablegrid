<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <style name="MyDefaultTextAppearance" parent="@android:style/TextAppearance">
     <item name="android:textSize">12sp</item>
    <item name="android:textColor">#333</item>
     <item name="android:textStyle">bold</item>
    </style>
    <style name="MyTheme" parent="android:Theme.Light">
    <item name="android:textAppearance">@style/MyDefaultTextAppearance</item>
</style>
    <declare-styleable name="ShadowLayout">
        <attr format="boolean" name="sl_shadowed"/>
        <attr format="dimension" name="sl_shadow_distance"/>
        <attr format="integer" name="sl_shadow_angle"/>
        <attr format="dimension" name="sl_shadow_radius"/>
        <attr format="color" name="sl_shadow_color"/>
    </declare-styleable>
</resources>